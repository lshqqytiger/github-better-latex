{
  "manifest_version": 3,
  "name": "GitHub Better LaTeX",
  "version": "0.1.0",
  "description": "Re-render LaTeX in GitHub Markdown.",
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["katex.min.css", "texmath.css", "fonts/*"],
      "matches": ["https://github.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["copilot-source.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"]
    }
  ]
}
